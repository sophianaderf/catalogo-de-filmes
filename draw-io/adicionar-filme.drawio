        <mxCell id="rgpPqXzyHmt1caEQAXpZ-37" parent="rgpPqXzyHmt1caEQAXpZ-4" style="strokeWidth=1;shadow=0;dashed=0;align=center;html=1;shape=mxgraph.mockup.forms.anchor;align=right;spacingRight=2;fontColor=#666666;" value="Sinopse:" vertex="1">
